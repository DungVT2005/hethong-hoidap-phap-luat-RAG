# ============================================================================
# CẤU HÌNH HỆ THỐNG HỎI ĐÁP PHÁP LUẬT AI + RAG (LuậtAI)
# Copy file này thành .env và điền GEMINI_API_KEY của bạn
# ============================================================================

# 1. Cấu hình Google Gemini API (Dùng để sinh câu trả lời)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Model sinh câu trả lời (hỗ trợ gemini-2.5-flash, gemini-2.0-flash, gemini-3.8-flash...)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# 2. Cấu hình Embedding (Mặc định: LOCAL để tiết kiệm quota Gemini API)
# Giá trị hỗ trợ: "local" (khuyên dùng) hoặc "gemini"
EMBEDDING_PROVIDER=local
# Model local embedding (SentenceTransformers đa ngôn ngữ hỗ trợ tiếng Việt tốt)
# Hệ thống tự động fallback sang ONNX / Local Vectorizer nếu chưa tải model
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Chỉ dùng khi EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# 3. Cho phép trả lời trích xuất cục bộ khi chưa cấu hình GEMINI_API_KEY (Demo mode)
# Đặt thành false nếu muốn bắt buộc báo lỗi FAILED khi chưa điền GEMINI_API_KEY
ALLOW_EXTRACTIVE_FALLBACK=true

# 4. Cấu hình Cơ sở dữ liệu (SQLite + ChromaDB)
SQLITE_DB_PATH=DB/legal_rag.db
SQLITE_SCHEMA_PATH=DB/legal_rag_schema_sqlite.sql
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=legal_chunks

# 5. Cấu hình Chia đoạn văn bản (Chunking) & Truy xuất (Retrieval)
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=200
RAG_TOP_K=5

# 6. Cấu hình Bảo mật & JWT
JWT_SECRET_KEY=luatai-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# 7. Tài khoản mặc định khi khởi tạo (Seed)
SEED_ADMIN_NAME=Quản trị viên
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
SEED_USER_NAME=Nguyễn Văn A
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=user12345
SEED_SAMPLE_DOCS=true
